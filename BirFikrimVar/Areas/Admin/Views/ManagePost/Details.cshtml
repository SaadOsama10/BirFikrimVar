@model BirFikrimVar.DAL.Post
@using BirFikrimVar.DAL
@using BirFikrimVar.Resources
@{
    ViewBag.Title = Model.Title;
}

<h2 class="post-header">@Model.Title</h2>

<div>
    <h4 class="post-tags">@Model.Tags</h4>
</div>
<hr />

<div class="post-plot-wrapper">

    @foreach (PostPlot postplot in Model.PostPlot)
    {
       <div class="row post-plot-item" style="margin-bottom:20px;">
           <div class="col-md-4">
               @if (!string.IsNullOrEmpty(postplot.ImageUrl))
               {
                   <img src="@postplot.ImageUrl" style="width:100%; height:250px; object-fit:cover;" />
               }
           </div>
           <div class="col-md-8">
               <p>@postplot.Text</p>
           </div>
       </div>

    }
</div>
<div>
    @Html.ActionLink(PostResources.Publish, "Publish", new { id = Model.Id }, new { @class = "btn btn-primary" })

    @Html.ActionLink(PostResources.Reject, "Reject", new { id = Model.Id }, new { @class = "btn btn-danger", style = "margin-left:10px;" })
</div>