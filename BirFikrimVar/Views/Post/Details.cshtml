@model BirFikrimVar.DAL.Post
@using BirFikrimVar.DAL
@using BirFikrimVar.Resources
@{
    ViewBag.Title = Model.Title;
    var likeCount = ViewBag.LikeCount as int? ?? 0;
    var hasLiked = ViewBag.HasLiked as bool? ?? false;
}

<h2 class="post-header">@Model.Title</h2>

<div>
    <h4 class="post-tags">@Model.Tags</h4>
</div>
<hr />

<div class="post-plot-wrapper">
    @foreach (PostPlot postplot in Model.PostPlot)
    {
        <div class="row post-plot-item" style="margin-bottom:20px;">
            @if (!string.IsNullOrWhiteSpace(postplot.ImageUrl))
            {
                <div class="col-md-4">
                    <img src="@postplot.ImageUrl" style="width:100%; height:250px; object-fit:cover;" />
                </div>
                <div class="col-md-8">
                    <p>@postplot.Text</p>
                </div>
            }
            else
            {
                <div class="col-md-12">
                    <p>@postplot.Text</p>
                </div>
            }
        </div>
    }
</div>

<div>
    @Html.ActionLink(PostResources.Comment,
            "Send", "Comment",
            new { id = Model.Id },
            new { @class = "btn btn-primary" })

    @Html.ActionLink(PostResources.ShowComments,
            "Inbox", "Comment",
            new { id = Model.Id },
            new { @class = "btn btn-primary" })

    @Html.ActionLink(
            hasLiked ? PostResources.Liked : PostResources.Like,
            "Toggle", "Like",
            new { id = Model.Id },
            new
            {
                @class = hasLiked ? "btn btn-primary" : "btn btn-outline-primary",
                id = "btn-like"
            })

    <span id="like-count" class="badge" style="margin-left:8px; background:#6c757d; color:#fff;">
        @likeCount
    </span>

    @Html.ActionLink(PostResources.ShowLikers, "Likers", "Like",
            new { id = Model.Id }, new { @class = "btn btn-link", id = "btn-show-likers" })
</div>

<style>
    .btn-outline-primary {
        background-color: transparent;
        color: #0d6efd;
        border: 1px solid #0d6efd;
    }

    #like-count {
        vertical-align: middle;
    }
</style>