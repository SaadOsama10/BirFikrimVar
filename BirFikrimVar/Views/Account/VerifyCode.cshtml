@model BirFikrimVar.Models.VerifyCodeViewModel
@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.VerifyTitle;
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>

    @using (Html.BeginForm("VerifyCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("provider", Model.Provider)
        @Html.Hidden("rememberMe", Model.RememberMe)

        <h4>@PostResources.EnterVerificationCode</h4>
        <hr />
        @Html.ValidationSummary("", new { @class = "text-danger" })

        <div class="row">
            @Html.LabelFor(m => m.Code, PostResources.Code_, new { @class = "col-md-2 col-form-label" })
            <div class="col-md-10">
                @Html.TextBoxFor(m => m.Code, new { @class = "form-control", autocomplete = "one-time-code", inputmode = "numeric", placeholder = PostResources.Code_ })
                @Html.ValidationMessageFor(m => m.Code, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <div class="checkbox">
                    @Html.CheckBoxFor(m => m.RememberBrowser)
                    @Html.LabelFor(m => m.RememberBrowser, PostResources.RememberBrowser)
                </div>
            </div>
        </div>

        <div class="row">
            <div class="offset-md-2 col-md-10">
                <input type="submit" class="btn btn-outline-dark" value="@PostResources.Submit" />
            </div>
        </div>
    }
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}