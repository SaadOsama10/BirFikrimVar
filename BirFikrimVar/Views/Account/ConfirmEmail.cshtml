@using BirFikrimVar.Resources
@{
    ViewBag.Title = PostResources.ConfirmEmail;
}
<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>
    <div>
        <p>
            @PostResources.EmailThanks @Html.ActionLink(PostResources.LogLink, "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
        </p>
    </div>
</main>
