@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.ResetPasswordConfirmTitle;
}

<main aria-labelledby="title">
    <hgroup class="title">
        <h1 id="title">@ViewBag.Title.</h1>
    </hgroup>
    <div>
        <p>
            @PostResources.ResetPasswordDone
            @Html.ActionLink(PostResources.LoginHere, "Login", "Account", routeValues: null, htmlAttributes: new { id = "loginLink" })
        </p>
    </div>
</main>