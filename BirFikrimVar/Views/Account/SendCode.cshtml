@model BirFikrimVar.Models.SendCodeViewModel
@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.SendCodeTitle;
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>

    @using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.Hidden("rememberMe", Model.RememberMe)

        <h4>@PostResources.SendVerificationCode</h4>
        <hr />

        <div class="row">
            <div class="col-md-8">
                <label for="SelectedProvider">@PostResources.Select2FAProvider</label>
                @Html.DropDownListFor(m => m.SelectedProvider, Model.Providers, new { @class = "form-control" })

                <input type="submit" value="@PostResources.Submit" class="btn btn-outline-dark" style="margin-top:10px;" />
            </div>
        </div>
    }
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}