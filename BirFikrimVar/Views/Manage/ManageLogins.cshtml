@model BirFikrimVar.Models.ManageLoginsViewModel
@using Microsoft.Owin.Security
@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.ManageExternalLoginsTitle;
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title.</h2>

    <p class="text-success">@ViewBag.StatusMessage</p>

    @{
        var loginProviders = Context.GetOwinContext().Authentication.GetExternalAuthenticationTypes();
        if (loginProviders.Count() == 0)
        {
            <div>
                <p>
                    @PostResources.NonCon1
                    <a href="https://go.microsoft.com/fwlink/?LinkId=313242" target="_blank">@PostResources.Article</a>
                    @PostResources.NonCon2
                </p>
            </div>
        }
        else
        {
            if (Model.CurrentLogins.Count > 0)
            {
                <h4>@PostResources.RegisteredLogins</h4>
                <table class="table">
                    <tbody>
                        @foreach (var account in Model.CurrentLogins)
                        {
                            <tr>
                                <td>@account.LoginProvider</td>
                                <td>
                                    @if (ViewBag.ShowRemoveButton)
                                    {
                                        using (Html.BeginForm("RemoveLogin", "Manage"))
                                        {
                                            @Html.AntiForgeryToken()
                                            <div>
                                                @Html.Hidden("loginProvider", account.LoginProvider)
                                                @Html.Hidden("providerKey", account.ProviderKey)
                                                <input type="submit"
                                                       class="btn btn-outline-dark"
                                                       value="@PostResources.Remove"
                                                       title="@string.Format(PostResources.RemoveThisLoginTitle, account.LoginProvider)" />
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        @: &nbsp;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            if (Model.OtherLogins.Count > 0)
            {
                using (Html.BeginForm("LinkLogin", "Manage"))
                {
                    @Html.AntiForgeryToken()
                    <div id="socialLoginList">
                        <p>
                            @foreach (AuthenticationDescription p in Model.OtherLogins)
                            {
                                <button type="submit"
                                        class="btn btn-default"
                                        id="@p.AuthenticationType"
                                        name="provider"
                                        value="@p.AuthenticationType"
                                        title="@string.Format(PostResources.ButtonTitle, p.Caption)">
                                    @p.AuthenticationType
                                </button>
                            }
                        </p>
                    </div>
                }
            }
        }
    }
</main>