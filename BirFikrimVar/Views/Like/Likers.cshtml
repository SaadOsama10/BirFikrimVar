@model IEnumerable<string>
@using System.Linq
@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.ShowLikers;
    var count = Model?.Count() ?? 0;
}

<h2>
    @ViewBag.Title
    <span class="badge">@count</span>
</h2>

@if (count == 0)
{
    <div class="alert alert-info">@PostResources.NoLikersYet</div>
}
else
{
    <ul class="list-group">
        @foreach (var name in Model)
        {
            <li class="list-group-item">@name</li>
        }
    </ul>
}