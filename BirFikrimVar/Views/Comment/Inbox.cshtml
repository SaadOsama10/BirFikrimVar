@model IEnumerable<BirFikrimVar.DAL.FeedbackMessage>
@using BirFikrimVar.DAL
@using BirFikrimVar.Resources

@{
    ViewBag.Title = PostResources.ShowComments;
}

<h2>ViewBag.Title</h2>


@foreach(var item in Model)
            {
                <div class="message-item">
                    <h3>@item.Post.Title</h3>
                    <span class="message-date">@(item.Date.HasValue ? item.Date.Value.ToString("dd/MM/yyyy") : "")</span>
                    <p>@item.Text</p>
                    <div class="message-sender">@UserHelper.GetUserNameById(item.UserId)</div>
                </div>
            }





