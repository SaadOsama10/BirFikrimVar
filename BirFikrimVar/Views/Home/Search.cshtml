@using BirFikrimVar.Resources
@model IEnumerable<BirFikrimVar.DAL.Post>
@using BirFikrimVar.DAL
@{
    ViewBag.Title = "Home Page";
}

<div style="font-size:20px; font-weight:bold; margin:20px 0;">
    @PostResources.SearchResultLabel @ViewBag.keywords
</div>

<main>
    <section style="margin-bottom:30px; text-align:center;">
        <h1 style="font-size:28px; font-weight:bold; margin-bottom:10px;">
            @SharedResources.ApplicationName
        </h1>
        <p style="font-size:16px; margin-bottom:15px;">
            @SharedResources.ApplicationDescription
        </p>
        <p>
            <a href="/Post/Create"
               class="btn btn-primary btn-md">
                @SharedResources.btnHaveIdea
            </a>
        </p>
    </section>

    <div>
        @foreach (Post post in Model)
        {
            <div style="border:2px solid #bae6fd;
                        border-radius:8px;
                        padding:15px 20px;
                        margin-bottom:15px;">

                <h2 style="margin:0 0 8px 0; font-size:22px;">
                    @post.Title
                </h2>

                <span style="display:block; font-size:14px; margin-bottom:8px;">
                    @UserHelper.GetUserNameById(post.Userd)
                </span>

                <div style="font-size:14px; margin-bottom:12px;">
                    @post.Tags
                </div>

                <div style="display:flex; gap:10px; flex-wrap:wrap;">
                    @Html.ActionLink(PostResources.Read,
                                          "Details",
                                          "Post",
                                          new { id = post.Id },
                                          new { @class = "btn btn-primary" })

                    @if (post.SavedPost != null &&
                         post.SavedPost.Any(p => p.UserId == UserHelper.GetCurrentUserId()))
                    {
                        @Html.ActionLink(PostResources.Saved,
                                              "DeletePost",
                                              "Post",
                                              new
                                              {
                                                  savedPostId = post.SavedPost
                                                                  .First(p => p.UserId == UserHelper.GetCurrentUserId()).Id
                                              },
                                              new { @class = "btn btn-primary" })
                    }
                    else
                    {
                        @Html.ActionLink(PostResources.SaveForLater,
                                              "SavedPost",
                                              "Post",
                                              new { id = post.Id },
                                              new { @class = "btn btn-primary" })
                    }
                </div>
            </div>
        }
    </div>
</main>