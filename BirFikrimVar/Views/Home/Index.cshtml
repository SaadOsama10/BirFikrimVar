@using BirFikrimVar.Resources
@model IEnumerable<BirFikrimVar.DAL.Post>
@using BirFikrimVar.DAL
@using BirFikrimVar.Business
@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">@SharedResources.ApplicationName</h1>  
        <p class="lead">@SharedResources.ApplicationDescription</p>
        <p><a href="/Post/Create" class="btn btn-primary btn-md">@SharedResources.btnHaveIdea</a></p>
    </section>  

    <div class="post-list-wrapper">
        @foreach (Post post in Model)
        {

                <div style="
                border:2px solid #bae6fd;
                border-radius:8px;
                padding:12px 18px;
                margin-bottom:50px;
                ">
                    <h2 style="margin:0;">@post.Title</h2>
              
           
                    <span class="writer-name">
                        @UserHelper.GetUserNameById(post.Userd)
                    </span>
            <div class="tags">
                @post.Tags
            </div>
            <div class="action">
                @Html.ActionLink(PostResources.Read,
     "Details",
     "Post",
     new { id = post.Id },
     new { @class = "btn btn-primary" })

                @if (post.SavedPost != null &&
                        post.SavedPost
                        .Where(p => p.UserId == UserHelper.GetCurrentUserId())
                        .ToList()
                        .Count > 0)

                {
                    @Html.ActionLink(PostResources.Saved,
                                      "DeletePost",
                                      "Post",
                                      new
                                      {
                                          savedPostId = post
                                      .SavedPost
                                      .Where(p => p.UserId == UserHelper.GetCurrentUserId()).First().Id
                                      },


                                      new { @class = "btn btn-primary" })
                
                    }
                   else {
                        @Html.ActionLink(PostResources.SaveForLater,
                                                     "SavedPost",
                                                     "Post",
                                                     new { id = post.Id },
                                                     new { @class = "btn btn-primary" }) }
            </div>
            </div>
                        }

    </div>

    
</main>