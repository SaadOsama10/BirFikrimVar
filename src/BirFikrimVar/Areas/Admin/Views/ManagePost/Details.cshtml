@model Post
@{
    ViewData["Title"] = Model.Title;
}

<h2 class="post-header">@Model.Title</h2>
<div>
    <h4 class="post-tags">@Model.Tags</h4>
</div>
<hr />

<div class="post-plot-wrapper">
    @foreach (var postplot in Model.PostPlot)
    {
        <div class="row post-plot-item" style="margin-bottom:20px;">
            <div class="col-md-4">
                @if (!string.IsNullOrEmpty(postplot.ImageUrl))
                {
                    <img src="@postplot.ImageUrl" alt="" style="width:100%; height:250px; object-fit:cover;" />
                }
            </div>
            <div class="col-md-8">
                <p>@postplot.Text</p>
            </div>
        </div>
    }
</div>

<div class="d-flex" style="gap:10px;">
    <form asp-action="Publish" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-primary" id="btn-publish">@PostResources.Publish</button>
    </form>
    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn btn-danger" id="btn-reject">@PostResources.Reject</button>
    </form>
</div>
