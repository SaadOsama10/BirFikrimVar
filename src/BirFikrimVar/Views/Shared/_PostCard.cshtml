@model Post
@{
    var currentUser = Users.CurrentUserId;
    var saved = currentUser == null ? null : Model.SavedPost?.FirstOrDefault(p => p.UserId == currentUser);
}
<div class="post-card">
    <h2>@Model.Title</h2>
    <span class="writer-name">@Users.GetUserName(Model.Userd)</span>
    <div class="tags">@Model.Tags</div>
    <div class="action">
        <a class="btn btn-primary" asp-controller="Post" asp-action="Details" asp-route-id="@Model.Id">@PostResources.Read</a>
        @if (currentUser != null)
        {
            @if (saved != null)
            {
                <form asp-controller="Post" asp-action="DeletePost" asp-route-savedPostId="@saved.Id" method="post">
                    <button type="submit" class="btn btn-primary">@PostResources.Saved</button>
                </form>
            }
            else
            {
                <form asp-controller="Post" asp-action="SavedPost" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-primary">@PostResources.SaveForLater</button>
                </form>
            }
        }
    </div>
</div>
