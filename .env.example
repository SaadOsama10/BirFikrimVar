# Copy to .env and adjust. Never commit the real .env.

# PostgreSQL. Either an Npgsql connection string ...
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=birfikrimvar;Username=postgres;Password=change-me
# ... or a postgres:// URL (Neon / Supabase / Render style); used when the line above is empty:
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Used by docker-compose for the database container
POSTGRES_PASSWORD=change-me

# Admin account for the moderation area. It is only created when the password is set.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=change-me-to-a-long-password

# Optional demo content + a public demo account shown on the login page
Seed__DemoData=true
Seed__DemoEmail=demo@birfikrimvar.app
Seed__DemoPassword=Demo-Pass-2026
Seed__ShowDemoHint=true
