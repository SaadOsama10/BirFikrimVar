# Running without Docker: set these environment variables instead
# ConnectionStrings__DefaultConnection=Host=localhost;Database=birfikrimvar;Username=postgres;Password=...
# (a postgres://user:pass@host/db URL in DATABASE_URL also works)
# Seed__AdminEmail / Seed__AdminPassword / Seed__DemoData / Seed__DemoEmail / Seed__DemoPassword / Seed__ShowDemoHint
